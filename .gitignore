# ==========================================
# Sirius Smart Home Project .gitignore
# ESP32 Firmware + React Native Mobile App
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# Firmware Secrets
**/mqtt_config.cpp
!**/mqtt_config.example.cpp
**/wifi_credentials.h
!**/wifi_credentials.example.h
**/secrets.h
!**/secrets.example.h
**/secrets.json
!**/secrets.example.json

# ------------------------------------------
# Firmware & Embedded (ESP32 / Arduino / PlatformIO)
# ------------------------------------------
# Build outputs
*.bin
*.hex
*.elf
*.map
*.eep
*.o
*.d
*.a

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.clangd/

# ESP-IDF
sdkconfig.old
dependencies.lock

# Backups & Temp files
firmware_backups/
*_backups/
*.bak
*.orig
*~
*`

# ------------------------------------------
# React Native & Node.js
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Bundler & Metro cache
.metro-health-check*
*.jsbundle
metro-cache/
.cache/

# Test coverage
coverage/
*.lcov
.nyc_output/

# Temporary / Scaffolding directories
mobile/rn_init_v76/
mobile/*_temp/
mobile/*_init/
mobile/*_init*/

# ------------------------------------------
# Android
# ------------------------------------------
.gradle/
**/android/.gradle/
build/
**/android/build/
**/android/app/build/
local.properties
*.iml
*.hprof
.cxx/
**/android/.cxx/
.kotlin/
captures/
*.apk
*.aab

# Keystores (keep debug keystore)
*.keystore
*.jks
!debug.keystore

# ------------------------------------------
# iOS / macOS / Xcode
# ------------------------------------------
**/Pods/
/vendor/bundle/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
*.hmap
*.ipa
**/.xcode.env.local

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.fuse_hidden*

# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
# JetBrains / Android Studio
.idea/
*.iws
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Antigravity / Gemini IDE
.gemini/
